---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices } from '../lib/content';

const services = await getServices();

const links = [
  { label: '首页', href: '/', desc: '返回网站首页' },
  { label: '业务范围', href: '/services/', desc: '施工、改造、维保、咨询、充装' },
  { label: '维保合作中心', href: '/centers/', desc: '按地区查找就近服务网点' },
  { label: '工程案例', href: '/cases/', desc: '我们做过的项目' },
  { label: '资质荣誉', href: '/qualifications/', desc: '营业执照与行业资质' },
  { label: '联系我们', href: '/contact/', desc: '电话、地址与微信' },
];
---

<BaseLayout title="页面不存在" noindex={true}>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-6xl font-bold text-brand-200">404</p>
    <h1 class="mt-4 text-2xl font-bold text-ink-900">页面不存在或已被移动</h1>
    <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-ink-500">
      你访问的页面可能已经调整。可以从下面的入口继续，或者直接联系我们。
    </p>

    <div class="mt-10 grid gap-3 text-left sm:grid-cols-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-xl border border-ink-100 bg-white p-4 transition-all hover:border-brand-200 hover:shadow-md"
          >
            <span class="block font-semibold text-ink-900">{link.label}</span>
            <span class="mt-0.5 block text-xs text-ink-400">{link.desc}</span>
          </a>
        ))
      }
    </div>

    <div class="mt-10 border-t border-ink-100 pt-8">
      <p class="text-sm text-ink-400">热门业务</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-2">
        {
          services.map((service) => (
            <li>
              <a
                href={`/services/${service.id}/`}
                class="inline-block rounded-full border border-ink-200 px-4 py-2 text-sm text-ink-600 transition-colors hover:border-brand-300 hover:text-brand-600"
              >
                {service.data.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

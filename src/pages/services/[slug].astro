---
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureList from '../../components/FeatureList.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import StandardsList from '../../components/StandardsList.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CenterCard from '../../components/CenterCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getServices, getServiceLabels } from '../../lib/content';
import { getPublishedCenters, groupByRegion } from '../../lib/centers';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

/*
  只有消防维保页会挂接合作中心模块（frontmatter 里的 showCenters: true）。
  其他业务页完全不加载这部分数据。
*/
const labels = data.showCenters ? await getServiceLabels() : null;
const centers = data.showCenters ? await getPublishedCenters() : [];
const regionGroups = data.showCenters ? groupByRegion(centers) : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.title,
  description: data.summary,
  provider: { '@type': 'Organization', name: '三杰消防' },
};
---

<PageLayout
  title={data.title}
  subtitle={data.tagline}
  description={data.seo.description ?? data.summary}
  keywords={data.seo.keywords}
  noindex={data.seo.noindex}
  crumbs={[
    { label: '首页', href: '/' },
    { label: '业务范围', href: '/services/' },
    { label: data.navLabel },
  ]}
  jsonLd={jsonLd}
>
  <!-- 服务概述（Markdown 正文） -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-[2fr_1fr]">
      <div class="prose-cn max-w-none">
        <Content />
      </div>

      {
        data.scope.length > 0 && (
          <aside class="lg:pt-2">
            <div class="rounded-xl border border-ink-100 bg-ink-50/60 p-5">
              <h2 class="text-sm font-semibold text-ink-900">服务内容</h2>
              <ul class="mt-3 space-y-2.5">
                {data.scope.map((item) => (
                  <li class="text-sm">
                    <span class="font-medium text-ink-700">{item.title}</span>
                    {item.desc && (
                      <span class="mt-0.5 block text-xs leading-relaxed text-ink-400">
                        {item.desc}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </section>

  <!-- 适用场所 -->
  {
    data.audience.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-12">
        <SectionHeading title="适用场所" subtitle="以下类型的建筑与场所，我们都有对应的实施经验。" />
        <ul class="flex flex-wrap gap-2">
          {data.audience.map((tag) => (
            <li class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm text-ink-600">
              {tag}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- 服务优势 -->
  {
    data.advantages.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-12">
        <SectionHeading title="服务优势" />
        <FeatureList features={data.advantages} />
      </section>
    )
  }

  <!-- 服务流程 -->
  {
    data.process.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-12">
        <SectionHeading title="服务流程" subtitle="每一步都会明确时间节点，进度可随时查询。" />
        <ProcessSteps steps={data.process} />
      </section>
    )
  }

  <!-- 依据标准规范 —— 消防行业含金量最高的信任信号 -->
  {
    data.standards.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-12">
        <SectionHeading
          title={data.standardsTitle ?? '依据的标准规范'}
          subtitle={data.standardsSubtitle ?? '我们的作业与交付按现行国家标准执行。'}
        />
        <StandardsList standards={data.standards} />
      </section>
    )
  }

  <!-- 维保合作中心（仅消防维保页） -->
  {
    data.showCenters && regionGroups.length > 0 && (
      <section class="border-y border-ink-100 bg-ink-50/60">
        <div class="mx-auto max-w-6xl px-4 py-14">
          <SectionHeading
            title="维保合作中心"
            subtitle={data.centersIntro ?? '就近安排巡检与应急响应，选择所在地区查看联系方式。'}
          />

          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {regionGroups.flatMap((group) =>
              group.cities.flatMap((city) =>
                city.centers.map((center) => (
                  <CenterCard center={center} labels={labels!} showCover={false} />
                ))
              )
            )}
          </div>

          <div class="mt-8 text-center">
            <a
              href="/centers/"
              class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
            >
              查看全部合作中心
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- 常见问题 -->
  {
    data.faqs.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-14">
        <SectionHeading title="常见问题" />
        <FaqAccordion faqs={data.faqs} />
      </section>
    )
  }

  <!-- 报价说明 -->
  {
    data.pricing && (
      <section class="mx-auto max-w-6xl px-4 pb-14">
        <div class="rounded-xl border border-ink-100 bg-ink-50/60 p-6">
          <h2 class="text-lg font-bold text-ink-900">报价方式</h2>
          <p class="mt-2 text-sm text-ink-600">{data.pricing.mode}</p>
          {data.pricing.note && (
            <p class="mt-2 text-sm text-ink-400">{data.pricing.note}</p>
          )}
        </div>
      </section>
    )
  }

  <CtaBanner />
</PageLayout>

---
interface Props {
  faqs: Array<{ q: string; a: string }>;
  /** 是否输出 FAQPage 结构化数据 */
  jsonLd?: boolean;
}

const { faqs, jsonLd = true } = Astro.props;

/*
  用原生 <details> 实现，零 JavaScript。
  对 SEO 友好（内容都在 HTML 里），对性能友好（不阻塞首屏）。
*/
const schema =
  jsonLd && faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

{
  faqs.length > 0 && (
    <div class="divide-y divide-ink-100 overflow-hidden rounded-xl border border-ink-100 bg-white">
      {faqs.map((faq) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 transition-colors hover:bg-ink-50">
            <span class="font-medium text-ink-900">{faq.q}</span>
            <svg
              class="mt-1 h-4 w-4 shrink-0 text-ink-400 transition-transform group-open:rotate-45"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </summary>
          <div class="px-5 pb-5 text-sm leading-relaxed text-ink-500">{faq.a}</div>
        </details>
      ))}
    </div>
  )
}

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

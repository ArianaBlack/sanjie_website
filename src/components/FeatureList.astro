---
interface Props {
  features: Array<{ title: string; desc: string }>;
}

const { features } = Astro.props;
---

<ul class="grid gap-5 md:grid-cols-2">
  {
    features.map((feature) => (
      <li class="flex gap-3">
        <span
          class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600"
          aria-hidden="true"
        >
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none">
            <path d="M2.5 6.2l2.4 2.4L9.5 3.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div>
          <h3 class="font-semibold text-ink-900">{feature.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-500">{feature.desc}</p>
        </div>
      </li>
    ))
  }
</ul>

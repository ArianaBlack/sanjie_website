---
import type { ImageMetadata } from 'astro';
import type { CenterEntry } from '../lib/centers';
import type { ServiceSlug } from '../data/services';

interface Props {
  center: CenterEntry;
  /** slug → 业务短名 的映射 */
  labels: Map<ServiceSlug, string>;
  /** 是否展示门头图 */
  showCover?: boolean;
}

const { center, labels, showCover = true } = Astro.props;
const { data } = center;

const cover = data.cover as ImageMetadata | undefined;
const tel = data.phone?.trim();
---

<article class="card-glow flex flex-col overflow-hidden rounded-xl">
  {
    showCover && cover && (
      <img
        src={cover.src}
        alt={`${data.name}门头`}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover"
      />
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-base font-bold text-ink-900">
      <a href={`/centers/${center.id}/`} class="transition-colors hover:text-brand-600">
        {data.shortName ?? data.name}
      </a>
    </h3>

    {
      data.serviceArea.length > 0 && (
        <p class="mt-1.5 text-xs text-ink-400">
          服务范围：{data.serviceArea.join('、')}
        </p>
      )
    }

    <ul class="mt-3 flex flex-wrap gap-1.5">
      {
        data.services.map((slug) => (
          <li class="rounded bg-brand-50 px-2 py-1 text-xs font-medium text-brand-700">
            {labels.get(slug) ?? slug}
          </li>
        ))
      }
    </ul>

    <dl class="mt-4 flex-1 space-y-2 text-sm">
      <div class="flex gap-2">
        <dt class="shrink-0 text-ink-400">地址</dt>
        <dd class="text-ink-600">{data.address}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="shrink-0 text-ink-400">营业</dt>
        <dd class="text-ink-600">{data.hours}</dd>
      </div>
    </dl>

    <div class="mt-5 flex gap-2">
      {
        tel && (
          <a
            href={`tel:${tel}`}
            class="flex-1 rounded-md bg-brand-600 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            电话咨询
          </a>
        )
      }
      <a
        href={`/centers/${center.id}/`}
        class="flex-1 rounded-md border border-ink-200 py-2.5 text-center text-sm font-semibold text-ink-700 transition-colors hover:border-brand-300 hover:text-brand-600"
      >
        查看详情
      </a>
    </div>
  </div>
</article>

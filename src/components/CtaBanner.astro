---
import { PRIMARY_TEL } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = '需要消防服务？先聊聊你的项目',
  subtitle = '留下联系方式或直接来电，我们安排专业人员对接，先看现场再谈方案。',
} = Astro.props;

const tel = PRIMARY_TEL;
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div class="bg-hero noise relative overflow-hidden rounded-3xl px-7 py-12 md:px-14 md:py-16">
    <div class="grid-pattern pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -right-16 -top-24 h-72 w-72 rounded-full bg-accent-400/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h2 class="text-2xl font-bold text-white md:text-3xl">{title}</h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-brand-100">{subtitle}</p>
      </div>

      <div class="flex shrink-0 flex-wrap gap-3">
        {
          tel && (
            <a
              href={`tel:${tel}`}
              class="rounded-xl bg-white px-7 py-3.5 text-sm font-semibold text-brand-700 shadow-lg shadow-brand-950/20 transition-transform hover:-translate-y-0.5"
            >
              {tel}
            </a>
          )
        }
        <a
          href="/contact/"
          class="rounded-xl border border-white/25 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition-colors hover:border-white/40 hover:bg-white/10"
        >
          在线留言
        </a>
      </div>
    </div>
  </div>
</section>

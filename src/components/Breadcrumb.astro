---
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  /** 是否输出 BreadcrumbList 结构化数据 */
  jsonLd?: boolean;
}

const { items, jsonLd = true } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).href } : {}),
  })),
};
---

<nav aria-label="面包屑" class="text-sm text-ink-400">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {item.href && i < items.length - 1 ? (
            <a href={item.href} class="transition-colors hover:text-brand-600">
              {item.label}
            </a>
          ) : (
            <span class="text-ink-500" aria-current="page">
              {item.label}
            </span>
          )}
          {i < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

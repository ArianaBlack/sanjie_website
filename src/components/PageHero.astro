---
import Breadcrumb, { type Crumb } from './Breadcrumb.astro';

interface Props {
  title: string;
  /** 标题下方的一句话说明 */
  subtitle?: string;
  crumbs?: Crumb[];
}

const { title, subtitle, crumbs } = Astro.props;
---

<section class="bg-soft relative overflow-hidden border-b border-ink-100">
  <!-- 右上角光晕：让内页头图不至于是一块死板的浅灰 -->
  <div
    class="pointer-events-none absolute -right-24 -top-40 h-96 w-96 rounded-full bg-brand-200/40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-20 bottom-0 h-56 w-56 rounded-full bg-accent-300/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pb-12 pt-7">
    {crumbs && crumbs.length > 0 && <Breadcrumb items={crumbs} />}

    <h1 class="mt-6 text-3xl font-bold tracking-tight md:text-5xl">
      {title}
    </h1>

    <!-- 渐变分隔条 -->
    <div
      class="mt-5 h-1 w-16 rounded-full bg-gradient-to-r from-brand-500 to-accent-400"
      aria-hidden="true"
    >
    </div>

    {subtitle && <p class="mt-5 max-w-3xl text-base leading-relaxed text-ink-500">{subtitle}</p>}
  </div>
</section>

---
interface Props {
  steps: Array<{ title: string; desc: string; duration?: string }>;
}

const { steps } = Astro.props;
---

<ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((step, i) => (
      <li class="relative rounded-xl border border-ink-100 bg-white p-5">
        <div class="flex items-baseline gap-2">
          <span
            class="text-2xl font-bold text-brand-200"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="font-semibold text-ink-900">{step.title}</h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink-500">{step.desc}</p>
        {step.duration && (
          <p class="mt-3 inline-block rounded bg-ink-50 px-2 py-1 text-xs text-ink-500">
            {step.duration}
          </p>
        )}
      </li>
    ))
  }
</ol>
